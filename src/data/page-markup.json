4H14V11.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span>\n  </button></div>\n    <div id=\"empty-state\" hidden><h3>Więcej miejsca na wybór.</h3><p>Żaden dom nie spełnia obu warunków. Zmień powierzchnię ogrodu lub pokaż wszystkie domy.</p><button class=\"text-link\" id=\"reset-filters\">Wyczyść filtry <span>↗</span></button></div>\n    <div class=\"house-list-footer\"><p id=\"list-progress\" aria-live=\"polite\">Pokazujemy 6 z 12 domów</p><button id=\"show-more\" class=\"text-link\">Pokaż kolejne domy <span>↓</span></button><span>Rzuty 3D — ilustracje poglądowe</span></div>\n  </div>\n</section>\n<section id=\"cennik\" class=\"pricing section\" aria-labelledby=\"pricing-title\">\n  <div class=\"container\">\n    <div class=\"pricing-heading\"><div><h2 id=\"pricing-title\">Porównajcie <em>swój wybór.</em></h2><p>Wszystkie parametry i ceny. W jednym miejscu.</p></div><div class=\"price-opening\"><span>Dom z prywatnym ogrodem</span><p><small>od</small> <strong id=\"price-from\">1 249 000</strong> <small>zł</small></p><span class=\"price-demo\">Ceny przykładowe · podgląd</span></div></div>\n    <div class=\"price-toolbar\"><div class=\"price-filter-tabs\" role=\"group\" aria-label=\"Domy w cenniku\"><button data-price-filter=\"available\" aria-pressed=\"true\" class=\"active\">Dostępne <span>05</span></button><button data-price-filter=\"all\" aria-pressed=\"false\">Wszystkie domy <span>12</span></button></div><span class=\"price-table-caption\">Nektarowa / Etap I</span><button id=\"download-prices\" class=\"text-link\">Pobierz zestawienie <svg class=\"small-direction direction-down\" width=\"16\" height=\"16\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4.5 13.5L14 4M6.5 4H14V11.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></div>\n    <label class=\"price-mobile-sort\" for=\"price-sort